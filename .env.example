# OPENROUTER_API_KEY: Required for all AI features (summary polish, bullet
# rewrites, ATS tailoring, cover letters, translation). Without it the app
# still runs fully offline; only the AI endpoints return a configuration error.
# Keep this server-side — never expose it in client bundles or logs.
OPENROUTER_API_KEY="MY_OPENROUTER_API_KEY"

# OPENROUTER_MODEL: Model used for AI requests. Defaults to
# "nvidia/nemotron-3-ultra-550b-a55b:free" when unset or blank. Change to any
# model id supported by your OpenRouter account.
# OPENROUTER_MODEL="nvidia/nemotron-3-ultra-550b-a55b:free"

# APP_URL: Optional public URL of this app, sent to OpenRouter purely for
# provider attribution (HTTP-Referer header). Leave blank to omit.
# APP_URL="http://localhost:3000"

# APP_NAME: Optional application name, sent to OpenRouter for provider
# attribution (X-Title header). Leave blank to omit.
# APP_NAME="ResumeCraft AI"

# HOST: Interface the server binds to. Defaults to 127.0.0.1 (loopback only).
# Set to 0.0.0.0 for container/VM deployments (Cloud Run, Render, Railway,
# Fly.io) where the platform expects an external-facing listener.
# HOST="127.0.0.1"

# PORT: TCP port the server listens on. Defaults to 3000.
# PORT="3000"